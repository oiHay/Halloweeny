    <ui:VisualElement name="TitleContainer" style="top: 88px; position: absolute; left: auto; right: auto; bottom: auto; align-items: center; justify-content: flex-start; align-self: center;">
        <ui:Image source="project://database/Assets/Art/UI/Menus/GameTitle.png?fileID=2800000&amp;guid=6258d1c81b7c40443a852ebf439bcc3e&amp;type=3#GameTitle"/>
    </ui:VisualElement>
</ui:UXML>
