:root {
}

.button {
    width: 330px;
    height: 90px;
    -unity-font-definition: url("project://database/Assets/Art/UI/Fonts/Merriweather/Merriweather-VariableFont_opsz,wdth,wght.ttf?fileID=12800000&guid=ab0415b1735086a408c0594fd30cbea2&type=3#Merriweather-VariableFont_opsz,wdth,wght");
    -unity-text-align: middle-center;
    font-size: 24px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(189, 189, 189);
    -unity-font-style: bold;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.button:hover {
    width: 330px;
    height: 90px;
    -unity-font-definition: url("project://database/Assets/Art/UI/Fonts/Merriweather/Merriweather-VariableFont_opsz,wdth,wght.ttf?fileID=12800000&guid=ab0415b1735086a408c0594fd30cbea2&type=3#Merriweather-VariableFont_opsz,wdth,wght");
    -unity-text-align: middle-center;
    font-size: 24px;
    background-color: rgba(55, 55, 55, 0);
    color: rgb(189, 189, 189);
    -unity-font-style: bold;
    background-image: url("project://database/Assets/Art/UI/Menus/Buttons/Menus_ButtonFrame.png?fileID=2800000&guid=79c07ad0950784946bb46bb9c2083450&type=3#Menus_ButtonFrame");
    -unity-background-image-tint-color: rgb(99, 232, 159);
}

.ControlsHelpContainers {
    flex-direction: row;
    flex-wrap: wrap;
}

.ControlsHelpContainersText {
    font-size: 18px;
    color: rgb(72, 72, 72);
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}
